# ============================================================
# ENDPOINT - GÉNÉRATION PAR DESIGN ID
# ============================================================

@app.route('/api/generate/design', methods=['POST'])
def generate_from_design():
    """Génère le code à partir d'un design ID spécifique"""
    try:
        data = request.json
        design_id = data.get('design_id')
        domain = data.get('domain', 'industrial')
        mcu = data.get('mcu', 'riscv_rv32x')
        
        # Récupérer le design
        from llm_nas.real_designs import get_design_by_id
        design = get_design_by_id(design_id)
        
        if not design:
            return jsonify({"error": f"Design {design_id} non trouvé"}), 404
        
        # Générer le projet
        project_id = f"design_{design_id}_{datetime.now().strftime('%Y%m%d_%H%M%S')}"
        metrics = design.get('metrics', {})
        
        files = {
            'main.c': f'// Design: {design_id}\n// {design.get("name", "Unknown")}\n#include "config.h"\nint main() {{ return 0; }}\n',
            'config.h': f'#define DESIGN_ID "{design_id}"\n#define MODEL_PARAMS {design["algorithm"].get("parameters", 0)}\n',
            'Makefile': 'all:\n\tgcc -o main main.c\nclean:\n\trm -f main\n',
            'README.md': f'# {design_id}\n{design.get("description", "")}\n\nAccuracy: {metrics.get("accuracy", 0):.1%}\nLatency: {metrics.get("latency_ms", 0):.1f}ms'
        }
        
        project_dir = os.path.join(PROJECTS_DIR, project_id)
        os.makedirs(project_dir, exist_ok=True)
        
        for filename, content in files.items():
            with open(os.path.join(project_dir, filename), 'w') as f:
                f.write(content)
        
        return jsonify({
            "status": "success",
            "project_id": project_id,
            "design_id": design_id,
            "design_name": design.get('name', 'unknown'),
            "metrics": metrics,
            "download_url": f"/api/download/{project_id}"
        })
        
    except Exception as e:
        return jsonify({"error": str(e)}), 500

print("✅ Endpoint /api/generate/design ajouté")

