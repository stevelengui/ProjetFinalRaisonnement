@app.route('/api/meta/strategy/recommendation', methods=['POST'])
def strategy_recommendation():
    try:
        data = request.json
        context = context_analyzer.analyze(data)
        recommendation = meta_controller.evidence_evaluator.get_strategy_recommendation(context)
        return jsonify(recommendation)
    except Exception as e:
        return jsonify({"error": str(e)}), 500

@app.route('/api/meta/deployment/register', methods=['POST'])
def deployment_register():
    try:
        data = request.json
        design = data.get('design', {})
        expected_metrics = data.get('expected_metrics', {})
        deployment_id = meta_controller.post_monitor.register_deployment(design, expected_metrics)
        return jsonify({"status": "success", "deployment_id": deployment_id})
    except Exception as e:
        return jsonify({"error": str(e)}), 500

@app.route('/api/meta/deployment/metric', methods=['POST'])
def deployment_metric():
    try:
        data = request.json
        deployment_id = data.get('deployment_id')
        metric_name = data.get('metric_name')
        value = data.get('value')
        source = data.get('source', 'production')
        result = meta_controller.post_monitor.report_metric(deployment_id, metric_name, value, source)
        return jsonify(result)
    except Exception as e:
        return jsonify({"error": str(e)}), 500

@app.route('/api/meta/deployment/status/<deployment_id>', methods=['GET'])
